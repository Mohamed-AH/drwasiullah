{
  // Cloudflare Workers static-assets deploy. `node scripts/build.mjs` pre-renders site/ into dist/ (one real HTML file per page,
  // sitemap.xml, robots.txt, _redirects, 404.html) and wrangler publishes dist/. No npm dependencies are needed for the build.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "drwasiullah",
  // worker/index.js answers only /health (for uptime monitors); every other path is served by the static assets below.
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "build": {
    "command": "node scripts/build.mjs"
  },
  // Content database (phase 1 of docs/admin-portal-spec.md). Not used by the public pages yet; the binding also lets
  // `npx wrangler d1 migrations apply drwasiullah --remote` find db/migrations. The id is not a secret.
  "d1_databases": [
    { "binding": "DB", "database_name": "drwasiullah", "database_id": "32c9ae0a-c5bf-4e18-9be2-f28ef8e92924", "migrations_dir": "db/migrations" }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/health", "/health/"],
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
